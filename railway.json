{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/bot/Dockerfile",
    "watchPatterns": [
      "/apps/bot/**",
      "/packages/core/**",
      "/package.json",
      "/package-lock.json",
      "/tsconfig.base.json",
      "/railway.json",
      "/.dockerignore"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
