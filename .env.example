MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=engbot
APP_URL=https://your-app.example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=engmova_bot
ADMIN_NOTIFICATION_BOT_TOKEN=
# Telegram user IDs separated by commas, spaces or semicolons.
ADMIN_TELEGRAM_IDS=
SESSION_SECRET=
OPENAI_API_KEY=
AI_MODEL=gpt-5.4
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
# Optional speaking style override; defaults to a warm, friendly conversation partner.
TTS_INSTRUCTIONS=
STT_MODEL=gpt-4o-mini-transcribe

# Set false to disable product event logs and onboarding analytics checkpoints.
EVENT_LOGGING_ENABLED=true
